// CANIS — credentials template.
// Copy this file into EACH networked sketch folder (CANIS_Core/ and
// State_Machine_WiFi/) as "arduino_secrets.h" and fill in your values.
// The real arduino_secrets.h is gitignored so credentials never get committed.
#define SECRET_SSID    "YOUR_WIFI_NAME"      // 2.4GHz network (ESP32 can't do 5GHz)
#define SECRET_PASS    "YOUR_WIFI_PASSWORD"
#define SECRET_PI_HOST "192.168.1.50"        // Pi's IP from `hostname -I`
