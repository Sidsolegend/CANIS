# CANIS dashboard — systemd service
# Install on the Pi:
#   sudo cp ~/dashboard/canis-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now canis-dashboard
# Check:   systemctl status canis-dashboard
# Logs:    journalctl -u canis-dashboard -f
# Update:  sudo systemctl restart canis-dashboard   (after changing app.py)

[Unit]
Description=CANIS dashboard (Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sidsolegend
WorkingDirectory=/home/sidsolegend/dashboard
ExecStart=/usr/bin/python3 /home/sidsolegend/dashboard/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
